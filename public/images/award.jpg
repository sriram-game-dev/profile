<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 520" width="100%" height="100%">
  <defs>
    <linearGradient id="aw-bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#070712" />
      <stop offset="50%" stop-color="#140f24" />
      <stop offset="100%" stop-color="#1c112d" />
    </linearGradient>
    <radialGradient id="aw-glow" cx="50%" cy="38%" r="60%">
      <stop offset="0%" stop-color="#f59e0b" stop-opacity="0.25" />
      <stop offset="50%" stop-color="#ef4444" stop-opacity="0.12" />
      <stop offset="100%" stop-color="#070712" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="aw-gold" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#fef08a" />
      <stop offset="25%" stop-color="#f59e0b" />
      <stop offset="50%" stop-color="#fbbf24" />
      <stop offset="75%" stop-color="#d97706" />
      <stop offset="100%" stop-color="#f59e0b" />
    </linearGradient>
    <pattern id="aw-grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#334155" stroke-width="0.5" stroke-opacity="0.3" />
      <polygon points="20,18 22,22 18,22" fill="#f59e0b" fill-opacity="0.2" />
    </pattern>
    <filter id="aw-shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#000000" flood-opacity="0.75" />
    </filter>
  </defs>

  <!-- Background Base -->
  <rect width="800" height="520" fill="url(#aw-bg)" />
  <rect width="800" height="520" fill="url(#aw-glow)" />
  <rect width="800" height="520" fill="url(#aw-grid)" />

  <!-- Outer Technical Certificate Frame -->
  <rect x="22" y="22" width="756" height="476" rx="8" fill="none" stroke="url(#aw-gold)" stroke-width="2" />
  <rect x="28" y="28" width="744" height="464" rx="6" fill="none" stroke="#ef4444" stroke-width="0.8" stroke-opacity="0.4" stroke-dasharray="6,4" />
  <rect x="34" y="34" width="732" height="452" rx="4" fill="none" stroke="#475569" stroke-width="0.5" stroke-opacity="0.3" />

  <!-- Corner Filigree -->
  <g transform="translate(34, 34)">
    <path d="M 0 0 L 32 0 L 32 6 L 6 6 L 6 32 L 0 32 Z" fill="url(#aw-gold)" />
    <circle cx="14" cy="14" r="2.5" fill="#fef08a" />
  </g>
  <g transform="translate(766, 34)">
    <path d="M 0 0 L -32 0 L -32 6 L -6 6 L -6 32 L 0 32 Z" fill="url(#aw-gold)" />
    <circle cx="-14" cy="14" r="2.5" fill="#fef08a" />
  </g>
  <g transform="translate(34, 486)">
    <path d="M 0 0 L 32 0 L 32 -6 L 6 -6 L 6 -32 L 0 -32 Z" fill="url(#aw-gold)" />
    <circle cx="14" cy="-14" r="2.5" fill="#fef08a" />
  </g>
  <g transform="translate(766, 486)">
    <path d="M 0 0 L -32 0 L -32 -6 L -6 -6 L -6 -32 L 0 -32 Z" fill="url(#aw-gold)" />
    <circle cx="-14" cy="-14" r="2.5" fill="#fef08a" />
  </g>

  <!-- Top Badge -->
  <g transform="translate(400, 68)" text-anchor="middle">
    <rect x="-195" y="-13" width="390" height="26" rx="13" fill="#130f21" stroke="url(#aw-gold)" stroke-width="1.2" />
    <text x="0" y="5" font-family="'Inter', -apple-system, sans-serif" font-size="10.5" font-weight="700" fill="#fde047" letter-spacing="3.5">
      GEN Z LEVEL UP · NATIONAL ESPORTS CHAMPIONSHIP
    </text>
  </g>

  <!-- Golden Trophy Crest Icon -->
  <g transform="translate(400, 122)" filter="url(#aw-shadow)">
    <!-- Trophy Cup -->
    <path d="M -16,-20 L 16,-20 L 12,2 C 12,12 5,16 0,16 C -5,16 -12,12 -12,2 Z" fill="url(#aw-gold)" stroke="#d97706" stroke-width="1.5" />
    <!-- Trophy Handles -->
    <path d="M -16,-14 C -26,-14 -24,2 -13,0" fill="none" stroke="url(#aw-gold)" stroke-width="2.2" />
    <path d="M 16,-14 C 26,-14 24,2 13,0" fill="none" stroke="url(#aw-gold)" stroke-width="2.2" />
    <!-- Trophy Stem and Base -->
    <rect x="-3" y="16" width="6" height="8" fill="#d97706" />
    <rect x="-12" y="24" width="24" height="5" rx="1.5" fill="url(#aw-gold)" />
    <!-- Star on Cup -->
    <polygon points="0,-12 2,-7 7,-7 3,-3 5,2 0,-1 -5,2 -3,-3 -7,-7 -2,-7" fill="#ffffff" />
  </g>

  <!-- Certificate Subtitle -->
  <text x="400" y="188" font-family="'Inter', -apple-system, sans-serif" font-size="12" font-weight="700" fill="#f59e0b" text-anchor="middle" letter-spacing="4">
    CERTIFICATE OF COMPETITIVE PARTICIPATION
  </text>

  <!-- Certificate Title -->
  <text x="400" y="222" font-family="'Inter', -apple-system, sans-serif" font-size="26" font-weight="900" fill="#f8fafc" text-anchor="middle" letter-spacing="0.5">
    EA SPORTS FC 26 TOURNAMENT
  </text>
  <text x="400" y="246" font-family="'Inter', -apple-system, sans-serif" font-size="13" font-weight="600" fill="#fde047" text-anchor="middle" letter-spacing="1.2">
    GEN Z LEVEL UP GAMING CHAMPIONSHIP · NATIONAL FINALS
  </text>

  <!-- Divider Line -->
  <g transform="translate(400, 264)">
    <line x1="-220" y1="0" x2="-20" y2="0" stroke="url(#aw-gold)" stroke-width="1" stroke-opacity="0.6" />
    <polygon points="0,-5 5,0 0,5 -5,0" fill="#f59e0b" />
    <line x1="20" y1="0" x2="220" y2="0" stroke="url(#aw-gold)" stroke-width="1" stroke-opacity="0.6" />
  </g>

  <!-- Conferred To Subtitle -->
  <text x="400" y="290" font-family="'Georgia', serif" font-size="13" font-style="italic" fill="#94a3b8" text-anchor="middle" letter-spacing="0.5">
    This certificate of competitive recognition is proudly presented to
  </text>

  <!-- Recipient Name -->
  <text x="400" y="328" font-family="'Inter', -apple-system, sans-serif" font-size="28" font-weight="900" fill="url(#aw-gold)" text-anchor="middle" letter-spacing="2">
    SRIRAM S
  </text>

  <!-- Description Text -->
  <text x="400" y="358" font-family="'Inter', -apple-system, sans-serif" font-size="11.5" font-weight="400" fill="#94a3b8" text-anchor="middle" letter-spacing="0.2">
    for outstanding competitive performance, tactical decision-making, sportsmanship, and fast
  </text>
  <text x="400" y="375" font-family="'Inter', -apple-system, sans-serif" font-size="11.5" font-weight="400" fill="#94a3b8" text-anchor="middle" letter-spacing="0.2">
    reflexes in the EA Sports FC 26 competitive esports arena championship.
  </text>

  <!-- Bottom Details &amp; Verification Section -->
  <!-- Left: Signature -->
  <g transform="translate(130, 420)">
    <path d="M 0 16 Q 30 0, 60 14 T 115 8 T 150 16" fill="none" stroke="#f59e0b" stroke-width="1.8" stroke-linecap="round" />
    <line x1="0" y1="24" x2="160" y2="24" stroke="#475569" stroke-width="1" />
    <text x="80" y="38" font-family="'Inter', -apple-system, sans-serif" font-size="9" font-weight="700" fill="#f8fafc" text-anchor="middle" letter-spacing="1">TOURNAMENT DIRECTOR</text>
    <text x="80" y="49" font-family="'Inter', -apple-system, sans-serif" font-size="8" font-weight="500" fill="#64748b" text-anchor="middle">Esports Operations Commission</text>
  </g>

  <!-- Center: Golden Laurel Seal -->
  <g transform="translate(400, 436)" filter="url(#aw-shadow)">
    <circle cx="0" cy="0" r="32" fill="#1b1226" stroke="url(#aw-gold)" stroke-width="2.2" />
    <circle cx="0" cy="0" r="26" fill="none" stroke="#fde047" stroke-width="0.8" stroke-dasharray="3,2" />
    <text x="0" y="-8" font-family="'Inter', sans-serif" font-size="8" font-weight="900" fill="#fde047" text-anchor="middle">★ ★ ★</text>
    <text x="0" y="4" font-family="'Inter', sans-serif" font-size="8.5" font-weight="800" fill="#ffffff" text-anchor="middle" letter-spacing="1">ESPORTS</text>
    <text x="0" y="14" font-family="'Inter', sans-serif" font-size="7" font-weight="700" fill="#f59e0b" text-anchor="middle" letter-spacing="1">VERIFIED</text>
  </g>

  <!-- Right: Verification &amp; Serial -->
  <g transform="translate(670, 420)" text-anchor="middle">
    <g transform="translate(-16, 0)">
      <rect x="0" y="0" width="32" height="20" rx="3" fill="#0f172a" stroke="#f59e0b" stroke-width="1.2" />
      <line x1="8" y1="5" x2="24" y2="5" stroke="#f59e0b" stroke-width="1.5" />
      <line x1="8" y1="10" x2="18" y2="10" stroke="#fde047" stroke-width="1.5" />
      <line x1="8" y1="15" x2="22" y2="15" stroke="#ef4444" stroke-width="1.5" />
    </g>
    <line x1="-80" y1="24" x2="80" y2="24" stroke="#475569" stroke-width="1" />
    <text x="0" y="38" font-family="'Inter', -apple-system, sans-serif" font-size="8.5" font-weight="700" fill="#f8fafc" letter-spacing="1">ID: GZE-EAFC26-0412-SR</text>
    <text x="0" y="49" font-family="'Inter', -apple-system, sans-serif" font-size="8" font-weight="500" fill="#fde047">Participated: 2026 · Esports</text>
  </g>
</svg>
