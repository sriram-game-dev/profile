<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 520" width="100%" height="100%">
  <defs>
    <linearGradient id="ut-bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#060a16" />
      <stop offset="50%" stop-color="#0c152b" />
      <stop offset="100%" stop-color="#111f3d" />
    </linearGradient>
    <radialGradient id="ut-glow" cx="50%" cy="38%" r="60%">
      <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.25" />
      <stop offset="50%" stop-color="#0284c7" stop-opacity="0.12" />
      <stop offset="100%" stop-color="#060a16" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="ut-cyan" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#7dd3fc" />
      <stop offset="50%" stop-color="#38bdf8" />
      <stop offset="100%" stop-color="#0284c7" />
    </linearGradient>
    <pattern id="ut-grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#1e293b" stroke-width="0.6" stroke-opacity="0.4" />
      <!-- isometric cube dots -->
      <circle cx="20" cy="20" r="1.5" fill="#38bdf8" fill-opacity="0.25" />
    </pattern>
    <filter id="ut-shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#000000" flood-opacity="0.75" />
    </filter>
  </defs>

  <!-- Background Base -->
  <rect width="800" height="520" fill="url(#ut-bg)" />
  <rect width="800" height="520" fill="url(#ut-glow)" />
  <rect width="800" height="520" fill="url(#ut-grid)" />

  <!-- Outer Technical Certificate Frame -->
  <rect x="22" y="22" width="756" height="476" rx="8" fill="none" stroke="url(#ut-cyan)" stroke-width="2" />
  <rect x="28" y="28" width="744" height="464" rx="6" fill="none" stroke="#f8fafc" stroke-width="0.8" stroke-opacity="0.3" stroke-dasharray="6,4" />
  <rect x="34" y="34" width="732" height="452" rx="4" fill="none" stroke="#475569" stroke-width="0.5" stroke-opacity="0.3" />

  <!-- Corner Brackets -->
  <g transform="translate(34, 34)">
    <path d="M 0 32 L 0 0 L 32 0" fill="none" stroke="#38bdf8" stroke-width="3" />
    <polygon points="6,6 18,6 18,10 10,10 10,18 6,18" fill="#ffffff" />
  </g>
  <g transform="translate(766, 34)">
    <path d="M 0 32 L 0 0 L -32 0" fill="none" stroke="#38bdf8" stroke-width="3" />
    <polygon points="-6,6 -18,6 -18,10 -10,10 -10,18 -6,18" fill="#ffffff" />
  </g>
  <g transform="translate(34, 486)">
    <path d="M 0 -32 L 0 0 L 32 0" fill="none" stroke="#38bdf8" stroke-width="3" />
    <polygon points="6,-6 18,-6 18,-10 10,-10 10,-18 6,-18" fill="#ffffff" />
  </g>
  <g transform="translate(766, 486)">
    <path d="M 0 -32 L 0 0 L -32 0" fill="none" stroke="#38bdf8" stroke-width="3" />
    <polygon points="-6,-6 -18,-6 -18,-10 -10,-10 -10,-18 -6,-18" fill="#ffffff" />
  </g>

  <!-- Top Badge -->
  <g transform="translate(400, 68)" text-anchor="middle">
    <rect x="-195" y="-13" width="390" height="26" rx="13" fill="#0c162d" stroke="url(#ut-cyan)" stroke-width="1.2" />
    <text x="0" y="5" font-family="'Inter', -apple-system, sans-serif" font-size="10.5" font-weight="700" fill="#bae6fd" letter-spacing="3.5">
      UNITY TECHNOLOGIES · OFFICIAL LEARNING PATHWAY
    </text>
  </g>

  <!-- Iconic Unity Isometric 3-Way Cube Crest -->
  <g transform="translate(400, 122)" filter="url(#ut-shadow)">
    <!-- Top Face -->
    <polygon points="0,-24 20,-12 0,0 -20,-12" fill="#ffffff" />
    <!-- Left Face -->
    <polygon points="-20,-12 0,0 0,24 -20,12" fill="#38bdf8" />
    <!-- Right Face -->
    <polygon points="20,-12 0,0 0,24 20,12" fill="#0284c7" />
    <!-- Inner arrows -->
    <circle cx="0" cy="0" r="4" fill="#0f172a" />
  </g>

  <!-- Certificate Subtitle -->
  <text x="400" y="188" font-family="'Inter', -apple-system, sans-serif" font-size="12" font-weight="700" fill="#38bdf8" text-anchor="middle" letter-spacing="4">
    COURSE COMPLETION CREDENTIAL
  </text>

  <!-- Certificate Title -->
  <text x="400" y="222" font-family="'Inter', -apple-system, sans-serif" font-size="27" font-weight="900" fill="#f8fafc" text-anchor="middle" letter-spacing="1">
    CREATE WITH CODE
  </text>
  <text x="400" y="246" font-family="'Inter', -apple-system, sans-serif" font-size="13" font-weight="600" fill="#7dd3fc" text-anchor="middle" letter-spacing="1.2">
    FOUNDATIONAL C# &amp; REAL-TIME 3D DEVELOPMENT IN UNITY
  </text>

  <!-- Divider Line -->
  <g transform="translate(400, 264)">
    <line x1="-220" y1="0" x2="-20" y2="0" stroke="url(#ut-cyan)" stroke-width="1" stroke-opacity="0.6" />
    <polygon points="0,-5 5,0 0,5 -5,0" fill="#38bdf8" />
    <line x1="20" y1="0" x2="220" y2="0" stroke="url(#ut-cyan)" stroke-width="1" stroke-opacity="0.6" />
  </g>

  <!-- Conferred To Subtitle -->
  <text x="400" y="290" font-family="'Georgia', serif" font-size="13" font-style="italic" fill="#94a3b8" text-anchor="middle" letter-spacing="0.5">
    Presented in recognition of successful completion to
  </text>

  <!-- Recipient Name -->
  <text x="400" y="328" font-family="'Inter', -apple-system, sans-serif" font-size="28" font-weight="900" fill="url(#ut-cyan)" text-anchor="middle" letter-spacing="2">
    SRIRAM S
  </text>

  <!-- Description Text -->
  <text x="400" y="358" font-family="'Inter', -apple-system, sans-serif" font-size="11.5" font-weight="400" fill="#94a3b8" text-anchor="middle" letter-spacing="0.2">
    for mastering official Unity curriculum covering C# scripting, player controllers,
  </text>
  <text x="400" y="375" font-family="'Inter', -apple-system, sans-serif" font-size="11.5" font-weight="400" fill="#94a3b8" text-anchor="middle" letter-spacing="0.2">
    physics simulation, UI systems, sound integration &amp; multiplatform game deployment.
  </text>

  <!-- Bottom Details &amp; Verification Section -->
  <!-- Left: Signature -->
  <g transform="translate(130, 420)">
    <path d="M 0 16 Q 30 2, 60 16 T 115 8 T 150 16" fill="none" stroke="#38bdf8" stroke-width="1.8" stroke-linecap="round" />
    <line x1="0" y1="24" x2="160" y2="24" stroke="#475569" stroke-width="1" />
    <text x="80" y="38" font-family="'Inter', -apple-system, sans-serif" font-size="9" font-weight="700" fill="#f8fafc" text-anchor="middle" letter-spacing="1">UNITY LEARN FACULTY</text>
    <text x="80" y="49" font-family="'Inter', -apple-system, sans-serif" font-size="8" font-weight="500" fill="#64748b" text-anchor="middle">Official Curriculum Lead</text>
  </g>

  <!-- Center: Unity Certified Associate Seal -->
  <g transform="translate(400, 436)" filter="url(#ut-shadow)">
    <circle cx="0" cy="0" r="32" fill="#0d1b33" stroke="url(#ut-cyan)" stroke-width="2.2" />
    <circle cx="0" cy="0" r="26" fill="none" stroke="#ffffff" stroke-width="0.8" stroke-dasharray="3,2" />
    <polygon points="0,-12 10,-2 7,10 -7,10 -10,-2" fill="#0284c7" stroke="#ffffff" stroke-width="1" />
    <text x="0" y="19" font-family="'Inter', sans-serif" font-size="7" font-weight="800" fill="#ffffff" text-anchor="middle" letter-spacing="1">UNITY</text>
  </g>

  <!-- Right: Verification &amp; Serial -->
  <g transform="translate(670, 420)" text-anchor="middle">
    <g transform="translate(-16, 0)">
      <rect x="0" y="0" width="32" height="20" rx="3" fill="#0f172a" stroke="#38bdf8" stroke-width="1.2" />
      <line x1="8" y1="5" x2="24" y2="5" stroke="#38bdf8" stroke-width="1.5" />
      <line x1="8" y1="10" x2="18" y2="10" stroke="#ffffff" stroke-width="1.5" />
      <line x1="8" y1="15" x2="22" y2="15" stroke="#7dd3fc" stroke-width="1.5" />
    </g>
    <line x1="-80" y1="24" x2="80" y2="24" stroke="#475569" stroke-width="1" />
    <text x="0" y="38" font-family="'Inter', -apple-system, sans-serif" font-size="8.5" font-weight="700" fill="#f8fafc" letter-spacing="1">ID: UNT-CWC-2023-SR</text>
    <text x="0" y="49" font-family="'Inter', -apple-system, sans-serif" font-size="8" font-weight="500" fill="#38bdf8">Completed: 2023 · Unity Learn</text>
  </g>
</svg>
