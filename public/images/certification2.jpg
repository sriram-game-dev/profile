<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 520" width="100%" height="100%">
  <defs>
    <linearGradient id="c2-bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#050814" />
      <stop offset="50%" stop-color="#0a1226" />
      <stop offset="100%" stop-color="#0f1b35" />
    </linearGradient>
    <radialGradient id="c2-glow" cx="50%" cy="40%" r="60%">
      <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.22" />
      <stop offset="45%" stop-color="#6366f1" stop-opacity="0.12" />
      <stop offset="100%" stop-color="#050814" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="c2-gold" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#fef08a" />
      <stop offset="25%" stop-color="#eab308" />
      <stop offset="50%" stop-color="#fde047" />
      <stop offset="75%" stop-color="#ca8a04" />
      <stop offset="100%" stop-color="#eab308" />
    </linearGradient>
    <linearGradient id="c2-cyan" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#38bdf8" />
      <stop offset="100%" stop-color="#818cf8" />
    </linearGradient>
    <pattern id="c2-guilloche" width="60" height="60" patternUnits="userSpaceOnUse">
      <circle cx="30" cy="30" r="28" fill="none" stroke="#1e293b" stroke-width="0.5" stroke-opacity="0.4" />
      <circle cx="30" cy="30" r="18" fill="none" stroke="#38bdf8" stroke-width="0.5" stroke-opacity="0.15" />
    </pattern>
    <filter id="c2-shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#000000" flood-opacity="0.75" />
    </filter>
  </defs>

  <!-- Background Base -->
  <rect width="800" height="520" fill="url(#c2-bg)" />
  <rect width="800" height="520" fill="url(#c2-glow)" />
  <rect width="800" height="520" fill="url(#c2-guilloche)" opacity="0.6" />

  <!-- Outer Certificate Border -->
  <rect x="22" y="22" width="756" height="476" rx="8" fill="none" stroke="url(#c2-gold)" stroke-width="2" />
  <rect x="28" y="28" width="744" height="464" rx="6" fill="none" stroke="#38bdf8" stroke-width="0.8" stroke-opacity="0.4" stroke-dasharray="6,4" />
  <rect x="34" y="34" width="732" height="452" rx="4" fill="none" stroke="#64748b" stroke-width="0.5" stroke-opacity="0.3" />

  <!-- Corner Filigree Ornaments -->
  <!-- Top Left -->
  <g transform="translate(34, 34)">
    <path d="M 0 0 L 36 0 L 36 6 L 6 6 L 6 36 L 0 36 Z" fill="url(#c2-gold)" />
    <circle cx="16" cy="16" r="3" fill="#38bdf8" />
  </g>
  <!-- Top Right -->
  <g transform="translate(766, 34)">
    <path d="M 0 0 L -36 0 L -36 6 L -6 6 L -6 36 L 0 36 Z" fill="url(#c2-gold)" />
    <circle cx="-16" cy="16" r="3" fill="#38bdf8" />
  </g>
  <!-- Bottom Left -->
  <g transform="translate(34, 486)">
    <path d="M 0 0 L 36 0 L 36 -6 L 6 -6 L 6 -36 L 0 -36 Z" fill="url(#c2-gold)" />
    <circle cx="16" cy="-16" r="3" fill="#38bdf8" />
  </g>
  <!-- Bottom Right -->
  <g transform="translate(766, 486)">
    <path d="M 0 0 L -36 0 L -36 -6 L -6 -6 L -6 -36 L 0 -36 Z" fill="url(#c2-gold)" />
    <circle cx="-16" cy="-16" r="3" fill="#38bdf8" />
  </g>

  <!-- Top Badge / Header Ribbon -->
  <g transform="translate(400, 68)" text-anchor="middle">
    <rect x="-190" y="-13" width="380" height="26" rx="13" fill="#0b1329" stroke="url(#c2-gold)" stroke-width="1.2" />
    <text x="0" y="5" font-family="'Inter', -apple-system, sans-serif" font-size="10.5" font-weight="700" fill="#fde047" letter-spacing="3.5">
      ALISON · GLOBAL EDUCATIONAL DIPLOMA
    </text>
  </g>

  <!-- Main Unity &amp; 3D Crest Icon -->
  <g transform="translate(400, 122)" filter="url(#c2-shadow)">
    <!-- Hexagonal Crest Shield -->
    <polygon points="0,-28 26,-13 26,17 0,32 -26,17 -26,-13" fill="#0f172a" stroke="url(#c2-gold)" stroke-width="1.8" />
    <!-- 3D Cube &amp; Unity Axis Core -->
    <path d="M 0,-15 L 14,-7 L 0,1 L -14,-7 Z" fill="#38bdf8" fill-opacity="0.9" />
    <path d="M -14,-7 L 0,1 L 0,17 L -14,9 Z" fill="#0284c7" />
    <path d="M 14,-7 L 0,1 L 0,17 L 14,9 Z" fill="#0369a1" />
  </g>

  <!-- Diploma Title -->
  <text x="400" y="188" font-family="'Inter', -apple-system, sans-serif" font-size="12" font-weight="700" fill="#38bdf8" text-anchor="middle" letter-spacing="4">
    DIPLOMA OF COMPLETION
  </text>
  <text x="400" y="222" font-family="'Inter', -apple-system, sans-serif" font-size="25" font-weight="900" fill="url(#c2-gold)" text-anchor="middle" letter-spacing="0.5">
    3D GAME DEVELOPMENT WITH UNITY
  </text>
  <text x="400" y="246" font-family="'Inter', -apple-system, sans-serif" font-size="13" font-weight="600" fill="#94a3b8" text-anchor="middle" letter-spacing="1.2">
    C# GAMEPLAY ARCHITECTURE · PHYSICS · LIGHTING &amp; ASSET PIPELINES
  </text>

  <!-- Horizontal Divider Line with Diamond -->
  <g transform="translate(400, 264)">
    <line x1="-220" y1="0" x2="-20" y2="0" stroke="url(#c2-gold)" stroke-width="1" stroke-opacity="0.6" />
    <polygon points="0,-5 5,0 0,5 -5,0" fill="#eab308" />
    <line x1="20" y1="0" x2="220" y2="0" stroke="url(#c2-gold)" stroke-width="1" stroke-opacity="0.6" />
  </g>

  <!-- Awarded To Subtitle -->
  <text x="400" y="290" font-family="'Georgia', serif" font-size="13" font-style="italic" fill="#94a3b8" text-anchor="middle" letter-spacing="0.5">
    This credential is formally awarded to
  </text>

  <!-- Recipient Name -->
  <text x="400" y="328" font-family="'Inter', -apple-system, sans-serif" font-size="28" font-weight="900" fill="#f8fafc" text-anchor="middle" letter-spacing="2">
    SRIRAM S
  </text>

  <!-- Description / Achievement text -->
  <text x="400" y="358" font-family="'Inter', -apple-system, sans-serif" font-size="11.5" font-weight="400" fill="#94a3b8" text-anchor="middle" letter-spacing="0.2">
    for successfully fulfilling all rigorous curriculum benchmarks in 3D Real-Time Simulation,
  </text>
  <text x="400" y="375" font-family="'Inter', -apple-system, sans-serif" font-size="11.5" font-weight="400" fill="#94a3b8" text-anchor="middle" letter-spacing="0.2">
    Component Lifecycle Management, Shaders, Multi-Platform Builds &amp; Game Mechanics.
  </text>

  <!-- Bottom Details &amp; Verification Section -->
  <!-- Left: Signature -->
  <g transform="translate(130, 420)">
    <path d="M 0 16 Q 25 0, 50 14 T 100 10 T 140 18" fill="none" stroke="#38bdf8" stroke-width="1.8" stroke-linecap="round" />
    <line x1="0" y1="24" x2="160" y2="24" stroke="#475569" stroke-width="1" />
    <text x="80" y="38" font-family="'Inter', -apple-system, sans-serif" font-size="9" font-weight="700" fill="#f8fafc" text-anchor="middle" letter-spacing="1">ALISON ACADEMIC BOARD</text>
    <text x="80" y="49" font-family="'Inter', -apple-system, sans-serif" font-size="8" font-weight="500" fill="#64748b" text-anchor="middle">Authorized Validation</text>
  </g>

  <!-- Center: Gold Holographic Seal -->
  <g transform="translate(400, 436)" filter="url(#c2-shadow)">
    <!-- Outer Star Points -->
    <circle cx="0" cy="0" r="32" fill="#0b1329" stroke="url(#c2-gold)" stroke-width="2.5" />
    <circle cx="0" cy="0" r="27" fill="none" stroke="#eab308" stroke-width="0.8" stroke-dasharray="3,2" />
    <!-- Laurel Wreath -->
    <path d="M -18 -10 C -24 0, -22 14, -10 20 C -16 12, -14 0, -10 -6" fill="#eab308" />
    <path d="M 18 -10 C 24 0, 22 14, 10 20 C 16 12, 14 0, 10 -6" fill="#eab308" />
    <!-- Center Stars &amp; Text -->
    <text x="0" y="-8" font-family="'Inter', sans-serif" font-size="8" font-weight="900" fill="#fde047" text-anchor="middle">★ ★ ★</text>
    <text x="0" y="4" font-family="'Inter', sans-serif" font-size="8.5" font-weight="800" fill="#ffffff" text-anchor="middle" letter-spacing="1">DIPLOMA</text>
    <text x="0" y="14" font-family="'Inter', sans-serif" font-size="7" font-weight="700" fill="#38bdf8" text-anchor="middle" letter-spacing="1">VERIFIED</text>
  </g>

  <!-- Right: Verification &amp; Serial -->
  <g transform="translate(670, 420)" text-anchor="middle">
    <!-- QR / Security Chip Icon -->
    <g transform="translate(-16, 0)">
      <rect x="0" y="0" width="32" height="20" rx="3" fill="#0f172a" stroke="#38bdf8" stroke-width="1.2" />
      <line x1="8" y1="5" x2="24" y2="5" stroke="#38bdf8" stroke-width="1.5" />
      <line x1="8" y1="10" x2="18" y2="10" stroke="#fde047" stroke-width="1.5" />
      <line x1="8" y1="15" x2="22" y2="15" stroke="#94a3b8" stroke-width="1.5" />
    </g>
    <line x1="-80" y1="24" x2="80" y2="24" stroke="#475569" stroke-width="1" />
    <text x="0" y="38" font-family="'Inter', -apple-system, sans-serif" font-size="8.5" font-weight="700" fill="#f8fafc" letter-spacing="1">ID: ALN-3DGD-2026-SR</text>
    <text x="0" y="49" font-family="'Inter', -apple-system, sans-serif" font-size="8" font-weight="500" fill="#38bdf8">Completed: 2026 · Course</text>
  </g>
</svg>
