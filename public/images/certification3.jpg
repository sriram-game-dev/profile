<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 450" width="100%" height="100%">
  <defs>
    <linearGradient id="tc3-bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#050614" />
      <stop offset="50%" stop-color="#0e0f2b" />
      <stop offset="100%" stop-color="#141133" />
    </linearGradient>
    <radialGradient id="tc3-glow" cx="50%" cy="40%" r="65%">
      <stop offset="0%" stop-color="#8b5cf6" stop-opacity="0.32" />
      <stop offset="45%" stop-color="#f59e0b" stop-opacity="0.16" />
      <stop offset="100%" stop-color="#050614" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="tc3-purple" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#c084fc" />
      <stop offset="50%" stop-color="#8b5cf6" />
      <stop offset="100%" stop-color="#fbbf24" />
    </linearGradient>
    <linearGradient id="tc3-titleGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" />
      <stop offset="100%" stop-color="#e2e8f0" />
    </linearGradient>
    <filter id="tc3-shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="12" stdDeviation="16" flood-color="#000000" flood-opacity="0.85" />
    </filter>
  </defs>

  <!-- Background Base -->
  <rect width="800" height="450" fill="url(#tc3-bg)" />
  <rect width="800" height="450" fill="url(#tc3-glow)" />

  <!-- Code Matrix Grid Pattern -->
  <g opacity="0.25">
    <line x1="0" y1="120" x2="800" y2="120" stroke="#334155" stroke-width="0.7" />
    <line x1="0" y1="180" x2="800" y2="180" stroke="#334155" stroke-width="0.7" />
    <line x1="200" y1="50" x2="200" y2="250" stroke="#334155" stroke-width="0.7" stroke-dasharray="4,4" />
    <line x1="600" y1="50" x2="600" y2="250" stroke="#334155" stroke-width="0.7" stroke-dasharray="4,4" />
  </g>

  <!-- Central Structured Prompt Terminal Window -->
  <g transform="translate(400, 155)" filter="url(#tc3-shadow)">
    <!-- Terminal Window -->
    <rect x="-200" y="-70" width="400" height="120" rx="10" fill="#0f1126" fill-opacity="0.9" stroke="#8b5cf6" stroke-width="1.8" />
    <rect x="-195" y="-65" width="390" height="20" fill="#1b1838" rx="5" />
    <!-- Window Controls -->
    <circle cx="-182" cy="-55" r="3.5" fill="#ef4444" />
    <circle cx="-171" cy="-55" r="3.5" fill="#f59e0b" />
    <circle cx="-160" cy="-55" r="3.5" fill="#10b981" />
    <text x="0" y="-51" font-family="'JetBrains Mono', monospace" font-size="9" font-weight="700" fill="#c084fc" text-anchor="middle">
      PROMPT_ARCHITECT.AI · CONTEXT CONDITIONING
    </text>

    <!-- Code Block Lines -->
    <text x="-180" y="-28" font-family="'JetBrains Mono', monospace" font-size="8.5" fill="#f59e0b">
      &lt;system&gt;<tspan fill="#e2e8f0"> role: "Autonomous Game Systems Engineer"</tspan> &lt;/system&gt;
    </text>
    <text x="-180" y="-12" font-family="'JetBrains Mono', monospace" font-size="8.5" fill="#38bdf8">
      &lt;context&gt;<tspan fill="#94a3b8"> framework: "Unity C# · ECS &amp; Job System"</tspan> &lt;/context&gt;
    </text>
    <text x="-180" y="4" font-family="'JetBrains Mono', monospace" font-size="8.5" fill="#c084fc">
      &lt;few-shot&gt;<tspan fill="#e2e8f0"> pattern: "Zero-Allocation State Machine"</tspan> &lt;/few-shot&gt;
    </text>
    <text x="-180" y="20" font-family="'JetBrains Mono', monospace" font-size="8.5" fill="#22c55e">
      &lt;output&gt;<tspan fill="#a7f3d0"> schema: "Structured JSON · Tokens: 128 / Max 4096"</tspan> &lt;/output&gt;
    </text>

    <!-- Terminal Prompt Cursor Pill -->
    <g transform="translate(145, 34)">
      <rect x="-40" y="-10" width="80" height="20" rx="4" fill="#1e1b4b" stroke="#8b5cf6" stroke-width="1" />
      <text x="0" y="4" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#fbbf24" text-anchor="middle">
        &gt; READY_
      </text>
    </g>
  </g>

  <!-- Top Left Badge -->
  <g transform="translate(35, 35)">
    <rect x="0" y="0" width="185" height="26" rx="13" fill="#0f1126" fill-opacity="0.85" stroke="#8b5cf6" stroke-width="1.2" />
    <circle cx="14" cy="13" r="4" fill="#8b5cf6" />
    <text x="26" y="17" font-family="'JetBrains Mono', monospace" font-size="10" font-weight="700" fill="#ddd6fe" letter-spacing="1.5">
      SIMPLILEARN · AI
    </text>
  </g>

  <!-- Top Right Badge -->
  <g transform="translate(615, 35)">
    <rect x="0" y="0" width="150" height="26" rx="13" fill="#0f1126" fill-opacity="0.85" stroke="#f59e0b" stroke-width="1.2" />
    <text x="75" y="17" font-family="'Inter', sans-serif" font-size="10" font-weight="700" fill="#fde047" text-anchor="middle" letter-spacing="2">
      SPECIALIST 2026
    </text>
  </g>

  <!-- Vignette Gradient at Bottom for Title Contrast -->
  <rect x="0" y="240" width="800" height="210" fill="url(#tc3-bg)" opacity="0.94" />

  <!-- Bottom Title Block -->
  <g transform="translate(400, 310)" text-anchor="middle" filter="url(#tc3-shadow)">
    <!-- Small Category Label -->
    <text x="0" y="0" font-family="'Inter', -apple-system, sans-serif" font-size="11" font-weight="800" fill="#c084fc" letter-spacing="4">
      SIMPLILEARN · ADVANCED AI SPECIALIZATION
    </text>
    <!-- Big Bold Title -->
    <text x="0" y="38" font-family="'Inter', -apple-system, sans-serif" font-size="33" font-weight="900" fill="url(#tc3-titleGrad)" letter-spacing="0.5">
      PROMPT ENGINEERING
    </text>
    <!-- Subtitle -->
    <text x="0" y="66" font-family="'Inter', -apple-system, sans-serif" font-size="13" font-weight="600" fill="#94a3b8" letter-spacing="1">
      CONTEXT DESIGN · FEW-SHOT CONDITIONING &amp; AI ORCHESTRATION
    </text>
  </g>

  <!-- Bottom Tech Pills / Tags -->
  <g transform="translate(400, 412)" text-anchor="middle">
    <!-- Pill 1 -->
    <rect x="-260" y="-12" width="120" height="24" rx="6" fill="#0f1126" stroke="#334155" stroke-width="1" />
    <text x="-200" y="4" font-family="'JetBrains Mono', monospace" font-size="9.5" font-weight="700" fill="#a78bfa">SYSTEM PROMPTS</text>

    <!-- Pill 2 -->
    <rect x="-125" y="-12" width="115" height="24" rx="6" fill="#0f1126" stroke="#334155" stroke-width="1" />
    <text x="-67" y="4" font-family="'JetBrains Mono', monospace" font-size="9.5" font-weight="700" fill="#f59e0b">FEW-SHOT</text>

    <!-- Pill 3 -->
    <rect x="10" y="-12" width="115" height="24" rx="6" fill="#0f1126" stroke="#334155" stroke-width="1" />
    <text x="67" y="4" font-family="'JetBrains Mono', monospace" font-size="9.5" font-weight="700" fill="#38bdf8">JSON SCHEMA</text>

    <!-- Pill 4 -->
    <rect x="145" y="-12" width="115" height="24" rx="6" fill="#0f1126" stroke="#334155" stroke-width="1" />
    <text x="202" y="4" font-family="'JetBrains Mono', monospace" font-size="9.5" font-weight="700" fill="#c084fc">ORCHESTRATION</text>
  </g>

  <!-- Corner Accents -->
  <path d="M 16 32 L 16 16 L 32 16" fill="none" stroke="#8b5cf6" stroke-width="2.5" />
  <path d="M 784 32 L 784 16 L 768 16" fill="none" stroke="#8b5cf6" stroke-width="2.5" />
  <path d="M 16 418 L 16 434 L 32 434" fill="none" stroke="#8b5cf6" stroke-width="2.5" />
  <path d="M 784 418 L 784 434 L 768 434" fill="none" stroke="#8b5cf6" stroke-width="2.5" />
</svg>
