<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 800" width="100%" height="100%">
  <defs>
    <linearGradient id="vrp-bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#070b19" />
      <stop offset="50%" stop-color="#111827" />
      <stop offset="100%" stop-color="#1e1b4b" />
    </linearGradient>
    <radialGradient id="vrp-paletteGlow" cx="50%" cy="40%" r="55%">
      <stop offset="0%" stop-color="#8b5cf6" stop-opacity="0.35" />
      <stop offset="50%" stop-color="#ec4899" stop-opacity="0.2" />
      <stop offset="100%" stop-color="#070b19" stop-opacity="0" />
    </radialGradient>
    <filter id="vrp-shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="16" stdDeviation="20" flood-color="#000000" flood-opacity="0.8" />
      <feDropShadow dx="0" dy="0" stdDeviation="15" flood-color="#8b5cf6" flood-opacity="0.4" />
    </filter>
  </defs>

  <rect width="1200" height="800" fill="url(#vrp-bg)" />
  <rect width="1200" height="800" fill="url(#vrp-paletteGlow)" />

  <!-- 3D Spatial Canvas / Easel with Neon Splatters -->
  <g transform="translate(600, 360)" filter="url(#vrp-shadow)">
    <!-- 3D Easel Canvas Floating in VR -->
    <rect x="-240" y="-180" width="480" height="360" rx="24" fill="#0f172a" stroke="#8b5cf6" stroke-width="4" />
    <rect x="-210" y="-150" width="420" height="300" rx="16" fill="#182032" />

    <!-- Neon Spatial Brush Strokes -->
    <path d="M -160 30 Q -60 -120, 80 -40 T 170 50" fill="none" stroke="#ec4899" stroke-width="18" stroke-linecap="round" />
    <path d="M -120 -60 Q 20 80, 140 -80" fill="none" stroke="#38bdf8" stroke-width="14" stroke-linecap="round" />
    <path d="M -90 80 Q 0 -20, 110 70" fill="none" stroke="#f59e0b" stroke-width="10" stroke-linecap="round" />
    <circle cx="80" cy="-40" r="16" fill="#34d399" />
    <circle cx="-50" cy="50" r="12" fill="#ec4899" />

    <!-- VR Paintbrush & Spatial Ray -->
    <g transform="translate(140, 100) rotate(-35)">
      <!-- Brush Handle -->
      <rect x="-8" y="-110" width="16" height="120" rx="8" fill="#475569" stroke="#94a3b8" stroke-width="2" />
      <!-- Ferrule (metal band) -->
      <rect x="-10" y="10" width="20" height="24" rx="3" fill="#cbd5e1" />
      <!-- Bristles loaded with glowing paint -->
      <path d="M -10 34 C -10 65, 0 75, 0 85 C 0 75, 10 65, 10 34 Z" fill="#ec4899" />
      <!-- Glow Drop -->
      <circle cx="0" cy="98" r="6" fill="#ec4899" />
    </g>

    <!-- Floating 3D Color Wheel / Palette (Left) -->
    <g transform="translate(-160, -90)">
      <circle cx="0" cy="0" r="42" fill="#0f172a" stroke="#475569" stroke-width="2" />
      <circle cx="-16" cy="-16" r="10" fill="#ec4899" />
      <circle cx="16" cy="-16" r="10" fill="#38bdf8" />
      <circle cx="20" cy="12" r="10" fill="#f59e0b" />
      <circle cx="-10" cy="20" r="10" fill="#22c55e" />
    </g>
  </g>

  <!-- Title Badge -->
  <g transform="translate(600, 710)">
    <rect x="-200" y="-30" width="400" height="52" rx="26" fill="#0f172a" fill-opacity="0.92" stroke="rgba(139, 92, 246, 0.4)" stroke-width="1.5" />
    <text x="0" y="3" font-family="'Montserrat', sans-serif" font-size="18" font-weight="900" fill="#f8fafc" text-anchor="middle" letter-spacing="2">VR PAINT EXPERIENCE</text>
  </g>
</svg>