<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 800" width="100%" height="100%">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#021c1e" />
      <stop offset="50%" stop-color="#0f2b3c" />
      <stop offset="100%" stop-color="#1e1b4b" />
    </linearGradient>
    <radialGradient id="sunGlow" cx="50%" cy="35%" r="55%">
      <stop offset="0%" stop-color="#fbbf24" stop-opacity="0.4" />
      <stop offset="45%" stop-color="#10b981" stop-opacity="0.2" />
      <stop offset="100%" stop-color="#021c1e" stop-opacity="0" />
    </radialGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="16" stdDeviation="20" flood-color="#000000" flood-opacity="0.75" />
    </filter>
  </defs>

  <rect width="1200" height="800" fill="url(#bg)" />
  <rect width="1200" height="800" fill="url(#sunGlow)" />

  <!-- 2D Platformer Parallax Background Layers -->
  <!-- Floating Sky Islands & Clouds -->
  <g opacity="0.4">
    <ellipse cx="200" cy="180" rx="90" ry="24" fill="#ffffff" />
    <ellipse cx="1000" cy="220" rx="120" ry="30" fill="#ffffff" />
    <!-- Distant Mountains -->
    <polygon points="0,520 220,340 440,520" fill="#064e3b" />
    <polygon points="350,520 620,290 890,520" fill="#047857" />
    <polygon points="780,520 1020,330 1200,520" fill="#064e3b" />
  </g>

  <!-- Foreground Pixelated / Vector Game Island & Character (Center) -->
  <g transform="translate(600, 360)" filter="url(#shadow)">
    <!-- Floating Grass Block Island -->
    <polygon points="-240,110 240,110 180,240 -180,240" fill="#78350f" stroke="#92400e" stroke-width="4" />
    <!-- Lush Grass Top Layer -->
    <rect x="-240" y="90" width="480" height="35" rx="8" fill="#10b981" />
    <path d="M -240 125 Q -210 145, -180 125 T -120 125 T -60 125 T 0 125 T 60 125 T 120 125 T 180 125 T 240 125" fill="#10b981" />

    <!-- Animated Flying Character with Jetpack / Wings -->
    <g transform="translate(-40, -40)">
      <!-- Rocket / Jet Thruster Particles -->
      <polygon points="-30,30 -50,60 -20,45" fill="#f59e0b" />
      <polygon points="-25,30 -40,80 -15,55" fill="#ef4444" />
      
      <!-- Jetpack -->
      <rect x="-35" y="-20" width="22" height="50" rx="8" fill="#475569" stroke="#94a3b8" stroke-width="2" />
      <!-- Hero Body Capsule -->
      <rect x="-15" y="-35" width="55" height="75" rx="26" fill="#3b82f6" stroke="#60a5fa" stroke-width="3" />
      <!-- Pilot Goggles / Visor -->
      <rect x="10" y="-24" width="34" height="20" rx="8" fill="#fde047" stroke="#ffffff" stroke-width="2" />
      <!-- Flying Scarf / Cape trailing behind -->
      <path d="M -15 -10 C -60 -30, -80 10, -130 -15" fill="none" stroke="#ef4444" stroke-width="12" stroke-linecap="round" />
    </g>

    <!-- Golden Collectible Coins Floating -->
    <g transform="translate(140, -60)">
      <circle cx="0" cy="0" r="22" fill="#f59e0b" stroke="#fde047" stroke-width="3" />
      <text x="0" y="7" font-family="'Montserrat', sans-serif" font-size="18" font-weight="900" fill="#ffffff" text-anchor="middle">★</text>
    </g>
    <g transform="translate(190, -110)">
      <circle cx="0" cy="0" r="16" fill="#f59e0b" stroke="#fde047" stroke-width="2.5" />
      <text x="0" y="5" font-family="'Montserrat', sans-serif" font-size="13" font-weight="900" fill="#ffffff" text-anchor="middle">★</text>
    </g>
  </g>

  <!-- Title Badge -->
  <g transform="translate(600, 710)">
    <rect x="-240" y="-30" width="480" height="52" rx="26" fill="#0f172a" fill-opacity="0.92" stroke="rgba(16, 185, 129, 0.4)" stroke-width="1.5" />
    <text x="0" y="3" font-family="'Montserrat', sans-serif" font-size="18" font-weight="900" fill="#f8fafc" text-anchor="middle" letter-spacing="2">FLY AWAY · 2D RUNNER GAME</text>
  </g>
</svg>