<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 800" width="100%" height="100%">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0a0518" />
      <stop offset="50%" stop-color="#140b2e" />
      <stop offset="100%" stop-color="#24104d" />
    </linearGradient>
    <radialGradient id="labGlow" cx="50%" cy="40%" r="55%">
      <stop offset="0%" stop-color="#c084fc" stop-opacity="0.35" />
      <stop offset="50%" stop-color="#38bdf8" stop-opacity="0.2" />
      <stop offset="100%" stop-color="#0a0518" stop-opacity="0" />
    </radialGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="16" stdDeviation="22" flood-color="#000000" flood-opacity="0.8" />
      <feDropShadow dx="0" dy="0" stdDeviation="20" flood-color="#a855f7" flood-opacity="0.4" />
    </filter>
  </defs>

  <rect width="1200" height="800" fill="url(#bg)" />
  <rect width="1200" height="800" fill="url(#labGlow)" />

  <!-- VR Physics Spatial Sandbox (Center) -->
  <g transform="translate(600, 360)" filter="url(#shadow)">
    <!-- 3D Spatial Grid Platform -->
    <ellipse cx="0" cy="150" rx="340" ry="110" fill="#0b071e" stroke="#a855f7" stroke-width="2.5" stroke-dasharray="10,6" />

    <!-- Articulated Bionic Hand Model (Telekinesis & Grab Poses) -->
    <g transform="translate(-40, 20)">
      <!-- Palm Base -->
      <rect x="-40" y="30" width="80" height="90" rx="20" fill="#1e1b4b" stroke="#c084fc" stroke-width="3" />
      <!-- Joint Trackers Glowing Dots -->
      <circle cx="-25" cy="50" r="5" fill="#38bdf8" />
      <circle cx="0" cy="45" r="5" fill="#38bdf8" />
      <circle cx="25" cy="50" r="5" fill="#38bdf8" />

      <!-- Fingers Curling in Grab Gesture -->
      <!-- Thumb -->
      <path d="M -40 60 L -75 40 L -65 15" fill="none" stroke="#c084fc" stroke-width="12" stroke-linecap="round" />
      <!-- Index -->
      <path d="M -25 30 L -30 -30 L -15 -65" fill="none" stroke="#c084fc" stroke-width="12" stroke-linecap="round" />
      <!-- Middle -->
      <path d="M 0 30 L 0 -40 L 15 -75" fill="none" stroke="#c084fc" stroke-width="12" stroke-linecap="round" />
      <!-- Ring -->
      <path d="M 25 30 L 25 -30 L 40 -60" fill="none" stroke="#c084fc" stroke-width="12" stroke-linecap="round" />
      <!-- Pinky -->
      <path d="M 40 50 L 55 0 L 65 -30" fill="none" stroke="#c084fc" stroke-width="10" stroke-linecap="round" />
    </g>

    <!-- Telekinesis Energy Rings Levitation -->
    <g transform="translate(140, -40)">
      <!-- Levitation Rings -->
      <ellipse cx="0" cy="0" rx="75" ry="30" fill="none" stroke="#38bdf8" stroke-width="2.5" stroke-dasharray="8,4" />
      <ellipse cx="0" cy="0" rx="60" ry="24" fill="none" stroke="#ec4899" stroke-width="2" />
      <!-- Floating Energy Cube (Physics Interactable) -->
      <polygon points="0,-45 40,-20 40,25 0,50 -40,25 -40,-20" fill="#8b5cf6" stroke="#c084fc" stroke-width="2.5" />
      <polygon points="0,-45 40,-20 0,0 -40,-20" fill="#a855f7" />
      <polygon points="0,0 40,-20 40,25 0,50" fill="#7c3aed" />
      <circle cx="0" cy="0" r="10" fill="#38bdf8" />
    </g>
  </g>

  <!-- Title Badge -->
  <g transform="translate(600, 710)">
    <rect x="-240" y="-30" width="480" height="52" rx="26" fill="#0f172a" fill-opacity="0.92" stroke="rgba(192, 132, 252, 0.4)" stroke-width="1.5" />
    <text x="0" y="3" font-family="'Montserrat', sans-serif" font-size="18" font-weight="900" fill="#f8fafc" text-anchor="middle" letter-spacing="2">VR INTERACTION LAB</text>
  </g>
</svg>