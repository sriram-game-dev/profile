<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 800" width="100%" height="100%">
  <defs>
    <linearGradient id="fac-bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#050a14" />
      <stop offset="50%" stop-color="#0f172a" />
      <stop offset="100%" stop-color="#1e293b" />
    </linearGradient>
    <radialGradient id="fac-forgeGlow" cx="50%" cy="40%" r="55%">
      <stop offset="0%" stop-color="#3b82f6" stop-opacity="0.3" />
      <stop offset="50%" stop-color="#f59e0b" stop-opacity="0.2" />
      <stop offset="100%" stop-color="#050a14" stop-opacity="0" />
    </radialGradient>
    <filter id="fac-shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="16" stdDeviation="20" flood-color="#000000" flood-opacity="0.8" />
    </filter>
  </defs>

  <rect width="1200" height="800" fill="url(#fac-bg)" />
  <rect width="1200" height="800" fill="url(#fac-forgeGlow)" />

  <!-- Factory Isometric Silhouette & Twin Robotic Arms -->
  <g transform="translate(600, 360)" filter="url(#fac-shadow)">
    <!-- Central Digital Twin Hologram Floor Platform -->
    <ellipse cx="0" cy="140" rx="360" ry="120" fill="#0b1329" stroke="#3b82f6" stroke-width="3" stroke-dasharray="10,6" />
    <ellipse cx="0" cy="140" rx="220" ry="70" fill="none" stroke="#f59e0b" stroke-width="2" />

    <!-- Industrial Factory Gear / Turbine Module -->
    <g transform="translate(0, 10)">
      <circle cx="0" cy="0" r="100" fill="#1e293b" stroke="#64748b" stroke-width="8" />
      <circle cx="0" cy="0" r="60" fill="#0f172a" stroke="#f59e0b" stroke-width="4" />
      <!-- Gear Teeth -->
      <rect x="-14" y="-120" width="28" height="30" rx="5" fill="#475569" />
      <rect x="-14" y="90" width="28" height="30" rx="5" fill="#475569" />
      <rect x="-120" y="-14" width="30" height="28" rx="5" fill="#475569" />
      <rect x="90" y="-14" width="30" height="28" rx="5" fill="#475569" />
      <!-- Diagonal teeth -->
      <rect x="-12" y="-115" width="24" height="25" rx="4" fill="#475569" transform="rotate(45)" />
      <rect x="-12" y="-115" width="24" height="25" rx="4" fill="#475569" transform="rotate(-45)" />
      <rect x="-12" y="-115" width="24" height="25" rx="4" fill="#475569" transform="rotate(135)" />
      <rect x="-12" y="-115" width="24" height="25" rx="4" fill="#475569" transform="rotate(-135)" />
      <text x="0" y="8" font-family="'JetBrains Mono', monospace" font-size="20" font-weight="900" fill="#38bdf8" text-anchor="middle">XR</text>
    </g>

    <!-- Articulated Robotic Arm Left -->
    <g transform="translate(-180, 50)">
      <rect x="-30" y="40" width="60" height="40" rx="8" fill="#1e293b" stroke="#3b82f6" stroke-width="2" />
      <path d="M 0 40 L -40 -60 L 50 -120" fill="none" stroke="#f59e0b" stroke-width="18" stroke-linecap="round" />
      <circle cx="-40" cy="-60" r="14" fill="#0f172a" stroke="#ffffff" stroke-width="3" />
      <circle cx="50" cy="-120" r="10" fill="#38bdf8" />
    </g>

    <!-- Articulated Robotic Arm Right -->
    <g transform="translate(180, 50)">
      <rect x="-30" y="40" width="60" height="40" rx="8" fill="#1e293b" stroke="#3b82f6" stroke-width="2" />
      <path d="M 0 40 L 40 -60 L -50 -120" fill="none" stroke="#3b82f6" stroke-width="18" stroke-linecap="round" />
      <circle cx="40" cy="-60" r="14" fill="#0f172a" stroke="#ffffff" stroke-width="3" />
      <circle cx="-50" cy="-120" r="10" fill="#f59e0b" />
    </g>
  </g>

  <!-- Title Badge -->
  <g transform="translate(600, 710)">
    <rect x="-240" y="-30" width="480" height="52" rx="26" fill="#0f172a" fill-opacity="0.92" stroke="rgba(59, 130, 246, 0.4)" stroke-width="1.5" />
    <text x="0" y="3" font-family="'Montserrat', sans-serif" font-size="18" font-weight="900" fill="#f8fafc" text-anchor="middle" letter-spacing="2">FACTORY VR PROTOTYPE</text>
  </g>
</svg>