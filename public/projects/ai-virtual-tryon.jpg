<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 800" width="100%" height="100%">
  <defs>
    <linearGradient id="ai-bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#08050f" />
      <stop offset="50%" stop-color="#10081e" />
      <stop offset="100%" stop-color="#1a0a2e" />
    </linearGradient>
    <radialGradient id="ai-neonPink" cx="50%" cy="40%" r="55%">
      <stop offset="0%" stop-color="#ec4899" stop-opacity="0.35" />
      <stop offset="60%" stop-color="#8b5cf6" stop-opacity="0.15" />
      <stop offset="100%" stop-color="#08050f" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="ai-cyberCyan" cx="20%" cy="30%" r="40%">
      <stop offset="0%" stop-color="#06b6d4" stop-opacity="0.25" />
      <stop offset="100%" stop-color="#08050f" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="ai-purpleGold" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#8b5cf6" />
      <stop offset="50%" stop-color="#ec4899" />
      <stop offset="100%" stop-color="#f59e0b" />
    </linearGradient>
    <filter id="ai-glow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="8" stdDeviation="16" flood-color="#ec4899" flood-opacity="0.5" />
      <feDropShadow dx="0" dy="0" stdDeviation="24" flood-color="#8b5cf6" flood-opacity="0.4" />
    </filter>
  </defs>

  <rect width="1200" height="800" fill="url(#ai-bg)" />
  <rect width="1200" height="800" fill="url(#ai-neonPink)" />
  <rect width="1200" height="800" fill="url(#ai-cyberCyan)" />

  <!-- Holographic Kiosk Booth (Center) -->
  <g transform="translate(600, 370)" filter="url(#ai-glow)">
    <!-- Mirror / Kiosk Glass Display -->
    <rect x="-190" y="-220" width="380" height="440" rx="36" fill="#0f172a" fill-opacity="0.8" stroke="url(#ai-purpleGold)" stroke-width="4" />
    <!-- Scanning Face Grid / Silhouette -->
    <g opacity="0.9">
      <!-- Human Silhouette Outline -->
      <circle cx="0" cy="-60" r="54" fill="none" stroke="#ec4899" stroke-width="3" stroke-dasharray="8,4" />
      <path d="M -80 70 C -80 0, 80 0, 80 70 Z" fill="none" stroke="#8b5cf6" stroke-width="3" stroke-dasharray="6,4" />
      <!-- AR Mesh Points on Face -->
      <circle cx="-20" cy="-65" r="4" fill="#06b6d4" />
      <circle cx="20" cy="-65" r="4" fill="#06b6d4" />
      <circle cx="0" cy="-50" r="4" fill="#ec4899" />
      <circle cx="-15" cy="-35" r="3" fill="#f59e0b" />
      <circle cx="15" cy="-35" r="3" fill="#f59e0b" />
      <path d="M -20 -65 L 0 -50 L 20 -65 L 15 -35 L -15 -35 Z" fill="none" stroke="#06b6d4" stroke-width="1.5" opacity="0.6" />

      <!-- Virtual Try-On Hairstyle Hologram Overlay -->
      <path d="M -60 -70 C -60 -130, 60 -130, 60 -70 C 70 -40, 50 -30, 45 -45 C 30 -100, -30 -100, -45 -45 C -50 -30, -70 -40, -60 -70 Z" fill="url(#ai-purpleGold)" opacity="0.75" />
    </g>

    <!-- AR Floating UI Badges -->
    <g transform="translate(-130, -140)">
      <rect x="0" y="0" width="100" height="28" rx="14" fill="#8b5cf6" fill-opacity="0.3" stroke="#8b5cf6" stroke-width="1.5" />
      <text x="50" y="18" font-family="'JetBrains Mono', monospace" font-size="10" font-weight="800" fill="#f8fafc" text-anchor="middle">AI STYLIST</text>
    </g>
    <g transform="translate(40, -140)">
      <rect x="0" y="0" width="90" height="28" rx="14" fill="#ec4899" fill-opacity="0.3" stroke="#ec4899" stroke-width="1.5" />
      <text x="45" y="18" font-family="'JetBrains Mono', monospace" font-size="10" font-weight="800" fill="#f8fafc" text-anchor="middle">AR PASSTHRU</text>
    </g>

    <!-- AR Interactive Carousel Selection Rings -->
    <g transform="translate(0, 140)">
      <ellipse cx="-70" cy="0" rx="30" ry="14" fill="#06b6d4" fill-opacity="0.2" stroke="#06b6d4" stroke-width="2" />
      <text x="-70" y="4" font-family="'Inter', sans-serif" font-size="10" font-weight="700" fill="#06b6d4" text-anchor="middle">Outfit A</text>

      <ellipse cx="0" cy="0" rx="36" ry="18" fill="#ec4899" fill-opacity="0.3" stroke="#ec4899" stroke-width="2.5" />
      <text x="0" y="5" font-family="'Inter', sans-serif" font-size="11" font-weight="800" fill="#ffffff" text-anchor="middle">Movie Style</text>

      <ellipse cx="70" cy="0" rx="30" ry="14" fill="#f59e0b" fill-opacity="0.2" stroke="#f59e0b" stroke-width="2" />
      <text x="70" y="4" font-family="'Inter', sans-serif" font-size="10" font-weight="700" fill="#f59e0b" text-anchor="middle">Hair #03</text>
    </g>
  </g>

  <!-- Title Badge -->
  <g transform="translate(600, 710)">
    <rect x="-260" y="-30" width="520" height="52" rx="26" fill="#0f172a" fill-opacity="0.92" stroke="rgba(236, 72, 153, 0.4)" stroke-width="1.5" />
    <text x="0" y="3" font-family="'Montserrat', sans-serif" font-size="18" font-weight="900" fill="#f8fafc" text-anchor="middle" letter-spacing="2">AI-POWERED AR VIRTUAL TRY-ON</text>
  </g>
</svg>