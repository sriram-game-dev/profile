<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 800" width="100%" height="100%">
  <defs>
    <linearGradient id="isv-bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0a0f1d" />
      <stop offset="50%" stop-color="#111827" />
      <stop offset="100%" stop-color="#1f2937" />
    </linearGradient>
    <radialGradient id="isv-electricGlow" cx="50%" cy="40%" r="55%">
      <stop offset="0%" stop-color="#eab308" stop-opacity="0.35" />
      <stop offset="50%" stop-color="#ef4444" stop-opacity="0.2" />
      <stop offset="100%" stop-color="#0a0f1d" stop-opacity="0" />
    </radialGradient>
    <filter id="isv-shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="16" stdDeviation="22" flood-color="#000000" flood-opacity="0.8" />
      <feDropShadow dx="0" dy="0" stdDeviation="15" flood-color="#eab308" flood-opacity="0.4" />
    </filter>
  </defs>

  <rect width="1200" height="800" fill="url(#isv-bg)" />
  <rect width="1200" height="800" fill="url(#isv-electricGlow)" />

  <!-- High-Voltage Transformer & Electrical Isolation Enclosure -->
  <g transform="translate(600, 360)" filter="url(#isv-shadow)">
    <!-- Electrical Cabinet -->
    <rect x="-220" y="-190" width="440" height="380" rx="20" fill="#1e293b" stroke="#475569" stroke-width="4" />

    <!-- Cabinet Top Vents & Breaker Panel -->
    <g transform="translate(0, -110)">
      <rect x="-180" y="-40" width="360" height="80" rx="10" fill="#0f172a" stroke="#334155" stroke-width="2" />
      <!-- Triple High-Voltage Breaker Switches -->
      <g transform="translate(-100, 0)">
        <rect x="-15" y="-25" width="30" height="50" rx="6" fill="#dc2626" />
        <circle cx="0" cy="12" r="5" fill="#ffffff" />
        <text x="0" y="-30" font-family="'JetBrains Mono', monospace" font-size="9" fill="#94a3b8" text-anchor="middle">L1: OFF</text>
      </g>
      <g transform="translate(0, 0)">
        <rect x="-15" y="-25" width="30" height="50" rx="6" fill="#dc2626" />
        <circle cx="0" cy="12" r="5" fill="#ffffff" />
        <text x="0" y="-30" font-family="'JetBrains Mono', monospace" font-size="9" fill="#94a3b8" text-anchor="middle">L2: OFF</text>
      </g>
      <g transform="translate(100, 0)">
        <rect x="-15" y="-25" width="30" height="50" rx="6" fill="#dc2626" />
        <circle cx="0" cy="12" r="5" fill="#ffffff" />
        <text x="0" y="-30" font-family="'JetBrains Mono', monospace" font-size="9" fill="#94a3b8" text-anchor="middle">L3: OFF</text>
      </g>
    </g>

    <!-- Permit To Work Certificate Hologram -->
    <g transform="translate(-80, 70)">
      <rect x="-70" y="-60" width="140" height="90" rx="8" fill="#0284c7" fill-opacity="0.2" stroke="#38bdf8" stroke-width="1.5" />
      <text x="0" y="-35" font-family="'Montserrat', sans-serif" font-size="10" font-weight="900" fill="#38bdf8" text-anchor="middle">PERMIT TO WORK</text>
      <line x1="-50" y1="-20" x2="50" y2="-20" stroke="#38bdf8" stroke-width="1.5" opacity="0.6" />
      <text x="0" y="0" font-family="'JetBrains Mono', monospace" font-size="9" fill="#f8fafc" text-anchor="middle">ISO-ID #4092-B</text>
      <text x="0" y="18" font-family="'JetBrains Mono', monospace" font-size="10" font-weight="800" fill="#22c55e" text-anchor="middle">✓ AUTHORIZED</text>
    </g>

    <!-- Heavy Padlock on Main Lockout Bar -->
    <g transform="translate(100, 70)">
      <path d="M -30 0 L -30 -30 C -30 -60, 30 -60, 30 -30 L 30 0" fill="none" stroke="#94a3b8" stroke-width="12" stroke-linecap="round" />
      <rect x="-45" y="-5" width="90" height="75" rx="14" fill="#eab308" stroke="#facc15" stroke-width="2" />
      <circle cx="0" cy="28" r="8" fill="#0f172a" />
      <polygon points="-4,30 4,30 3,46 -3,46" fill="#0f172a" />
      <!-- Hazard Lightning Bolt Symbol -->
      <polygon points="2,-4 -8,12 0,12 -2,24 8,8 0,8" fill="#b45309" />
    </g>
  </g>

  <!-- Title Badge -->
  <g transform="translate(600, 710)">
    <rect x="-290" y="-30" width="580" height="52" rx="26" fill="#0f172a" fill-opacity="0.92" stroke="rgba(234, 179, 8, 0.4)" stroke-width="1.5" />
    <text x="0" y="3" font-family="'Montserrat', sans-serif" font-size="18" font-weight="900" fill="#f8fafc" text-anchor="middle" letter-spacing="2">INDUSTRIAL LOTO &amp; SERVICES VR</text>
  </g>
</svg>