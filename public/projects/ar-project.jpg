<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 800" width="100%" height="100%">
  <defs>
    <linearGradient id="ar-bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#031520" />
      <stop offset="50%" stop-color="#082b3d" />
      <stop offset="100%" stop-color="#0e435a" />
    </linearGradient>
    <radialGradient id="ar-arGlow" cx="50%" cy="40%" r="55%">
      <stop offset="0%" stop-color="#06b6d4" stop-opacity="0.35" />
      <stop offset="50%" stop-color="#3b82f6" stop-opacity="0.15" />
      <stop offset="100%" stop-color="#031520" stop-opacity="0" />
    </radialGradient>
    <filter id="ar-shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="16" stdDeviation="22" flood-color="#000000" flood-opacity="0.8" />
    </filter>
  </defs>

  <rect width="1200" height="800" fill="url(#ar-bg)" />
  <rect width="1200" height="800" fill="url(#ar-arGlow)" />

  <!-- AR Mobile Phone Scanning Spatial Plane (Center) -->
  <g transform="translate(600, 360)" filter="url(#ar-shadow)">
    <!-- Real-world Floor Plane Mesh Detection (Grid Overlay) -->
    <polygon points="-280,180 280,180 180,60 -180,60" fill="#0891b2" fill-opacity="0.2" stroke="#06b6d4" stroke-width="2.5" stroke-dasharray="10,6" />
    <!-- Plane Tracking Feature Points (Yellow Crosses & Dots) -->
    <circle cx="-120" cy="110" r="5" fill="#facc15" />
    <circle cx="100" cy="90" r="5" fill="#facc15" />
    <circle cx="0" cy="140" r="6" fill="#facc15" />
    <circle cx="160" cy="130" r="4" fill="#facc15" />
    <circle cx="-80" cy="80" r="4" fill="#facc15" />

    <!-- 3D Virtual Robot / Hologram Placed on Floor -->
    <g transform="translate(0, 40)">
      <!-- Hologram Aura Base -->
      <ellipse cx="0" cy="25" rx="55" ry="18" fill="#06b6d4" fill-opacity="0.3" stroke="#22d3ee" stroke-width="2" />
      <!-- Robot Head -->
      <rect x="-30" y="-80" width="60" height="50" rx="14" fill="#0f172a" stroke="#06b6d4" stroke-width="3" />
      <rect x="-18" y="-68" width="36" height="18" rx="6" fill="#06b6d4" />
      <circle cx="-9" cy="-59" r="3" fill="#ffffff" />
      <circle cx="9" cy="-59" r="3" fill="#ffffff" />
      <!-- Robot Body -->
      <rect x="-24" y="-22" width="48" height="42" rx="10" fill="#1e293b" stroke="#0891b2" stroke-width="2" />
      <!-- Antennas -->
      <line x1="0" y1="-80" x2="0" y2="-95" stroke="#facc15" stroke-width="3" />
      <circle cx="0" cy="-98" r="4" fill="#facc15" />
    </g>

    <!-- AR Camera Viewfinder Frame / Reticle -->
    <g transform="translate(0, 30)">
      <path d="M -120 -80 L -150 -80 L -150 -50" fill="none" stroke="#22d3ee" stroke-width="4" />
      <path d="M 120 -80 L 150 -80 L 150 -50" fill="none" stroke="#22d3ee" stroke-width="4" />
      <path d="M -120 80 L -150 80 L -150 50" fill="none" stroke="#22d3ee" stroke-width="4" />
      <path d="M 120 80 L 150 80 L 150 50" fill="none" stroke="#22d3ee" stroke-width="4" />
      <!-- Tracking Status -->
      <rect x="-65" y="-120" width="130" height="26" rx="13" fill="#0f172a" stroke="#22d3ee" stroke-width="1.5" />
      <text x="0" y="-103" font-family="'JetBrains Mono', monospace" font-size="10" font-weight="800" fill="#22d3ee" text-anchor="middle">PLANE DETECTED</text>
    </g>
  </g>

  <!-- Title Badge -->
  <g transform="translate(600, 710)">
    <rect x="-240" y="-30" width="480" height="52" rx="26" fill="#0f172a" fill-opacity="0.92" stroke="rgba(6, 182, 212, 0.4)" stroke-width="1.5" />
    <text x="0" y="3" font-family="'Montserrat', sans-serif" font-size="18" font-weight="900" fill="#f8fafc" text-anchor="middle" letter-spacing="2">AUGMENTED REALITY LAB</text>
  </g>
</svg>